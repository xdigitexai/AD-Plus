DATABASE_URL="postgresql://adpulse:change-me@127.0.0.1:5432/adpulse"
AUTH_SECRET="replace-with-at-least-32-random-characters"
TOKEN_ENCRYPTION_KEY="replace-with-64-hex-characters"
APP_URL="http://localhost:3000"
TRUST_PROXY="false"
CURRENCY="USD"
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="https://getadpulse.tech/api/integrations/meta/callback"
PAYMENT_PROVIDER="xdigitex-pay"
XDIGITEX_PAY_API_KEY=""
XDIGITEX_PAY_BASE_URL="https://pay.xdigitex.space/api"
XDIGITEX_PAY_WEBHOOK_URL=""
# Local-currency rates used to debit Mobile Money, while the wallet is always credited in USD.
# The API documentation publishes no rate, so this is configuration: "<CURRENCY>=<units per USD>".
XDIGITEX_PAY_RATES="KES=130,CDF=2350,UGX=3800,XOF=620,XAF=620,RWF=1300,ZMW=25,SLE=22,USD=1"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrateur ADPulse"
